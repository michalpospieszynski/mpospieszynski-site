# Template for /opt/site/.env on the VPS (owned by the `gha` user, chmod 600). Placeholders only: never commit real values.
# docker compose reads this file for interpolation (infra/docker-compose.yml); each container gets only what it
# needs. The local dev stack (docker-compose.dev.yml) needs none of the secrets below.

# --- Images ---------------------------------------------------------------------------------------------------
# GHCR namespace the deploy workflow pushes to (I4), lowercase. The tag is not here: deploy.sh writes release.env.
REGISTRY=ghcr.io/<github-user>

# --- Cloudflare Tunnel ---------------------------------------------------------------------------------------
# From `cloudflared tunnel create site`; the credentials JSON stays on the VPS next to this file.
TUNNEL_ID=<tunnel-uuid>
TUNNEL_CREDENTIALS_FILE=./cloudflared/credentials.json

# --- Site ----------------------------------------------------------------------------------------------------
SITE_BASE_URL=https://mpospieszynski.pl
# Optional: extra hostnames the SSR server accepts (comma-separated), e.g. a test tunnel hostname.
NG_ALLOWED_HOSTS=

# --- Supabase ------------------------------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: public by design (the admin uses it in the browser). No service-role key anywhere.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Session pooler, TLS required; the user is the application role site_app (infra/supabase/roles.sql).
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=site_app.<project-ref>
SUPABASE_DB_PASSWORD=<strong-password>
SUPABASE_STORAGE_BUCKET=media

# --- Cloudflare Turnstile ------------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=<public-site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# --- Mail (SMTP provider) ------------------------------------------------------------------------------------
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=no-reply@mpospieszynski.pl
MAIL_OWNER_TO=<your-address>

# --- Privacy -------------------------------------------------------------------------------------------------
# Random secret for hashing visitor IPs (rate limit): openssl rand -base64 32
IP_HASH_SALT=<random-secret>
