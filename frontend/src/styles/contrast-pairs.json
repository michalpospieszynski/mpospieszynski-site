    { "label": "Soft on raised-2 (form labels)", "fg": "--color-soft", "bg": "--color-raised-2", "min": 4.5 },
    { "label": "Muted on raised-2", "fg": "--color-muted", "bg": "--color-raised-2", "min": 4.5 },
